<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.froggerpro.privacy">

    <!-- Needed to write secure/global settings (together with the privapp whitelist). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Write permission for LineageSettings (content://lineagesettings).
         lineageos.permission.WRITE_SETTINGS is signature|privileged.
         This app is platform-signed and privileged, so it is granted via the signature path;
         it is NOT added to the privapp whitelist. -->
    <uses-permission android:name="lineageos.permission.WRITE_SETTINGS" />

    <!--
        DeviceConfig permissions are signature-level; this app is signed with the platform
        certificate, so it qualifies. (per frameworks/base/core/res/AndroidManifest.xml)
    -->
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_lock_lock"
        android:theme="@android:style/Theme.DeviceDefault.Settings"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false">

        <activity
            android:name=".PrivacySettingsActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
