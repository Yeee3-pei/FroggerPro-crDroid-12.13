//
// FroggerPro privacy settings
//
// Kept in the device tree (not upstream) to avoid forking the upstream.
android_app {
    name: "FroggerProPrivacy",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    // Needs platform signature and privileged identity to write secure/global settings
    platform_apis: true,
    certificate: "platform",
    privileged: true,

    required: ["privapp_whitelist_FroggerProPrivacy"],

    optimize: {
        enabled: true,
        shrink: false,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_FroggerProPrivacy",
    src: "privapp-permissions-FroggerProPrivacy.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
