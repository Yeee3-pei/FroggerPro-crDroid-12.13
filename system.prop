# Debugging defaults that have to live in the system partition.
#
# PRODUCT_PROPERTY_OVERRIDES in device.mk lands in the vendor partition, which is not the one that is
# replaced when debugging a boot loop against a different vendor image, so the properties are declared here
# instead: everything under system/ ships from the framework partitions we build.
#
# USB debugging is off by default on a freshly wiped device, which makes the shell and logcat unreachable
# exactly when a boot loop needs to be diagnosed. Keeping a persistent logd buffer means the log of a boot
# that never finishes can still be pulled afterwards.
#
# No persist.sys.usb.config here: the framework writes that property itself ("adb" or empty), and a
# non-standard value made usbd request MTP-only while the framework requested ADB, so the device
# re-enumerated between the two until the framework overwrote the property.
persist.logd.logpersistd=logcatd

# Dalvik/ART heap values. The inherited phone-xhdpi-6144-dalvik-heap.mk sets all of
# them with ?=, and the vendor side sets the growth limit again in /vendor/build.prop
# and /vendor/etc/init/hw/init.target.rc -- its density-triggered rules only cover the
# 560 and 640 profiles, and this device reports 480 and still ends at 256m. The first
# three properties below therefore only restate what is already set; the last three
# override it: heaptargetutilization 0.75 (inherited 0.5), heapminfree 512k
# (inherited 8m), heapmaxfree 8m (inherited 32m).
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m



# Camcorder frame rates (60 fps recording).
#
# MediaProfiles builds the XML file name as "media_profiles" + the value of ro.media.xml_variant.profiles
# (see frameworks/av/media/libmedia/MediaProfiles.cpp getXmlPaths(), which defaults the variant to "_V1_0").
# It then searches product/etc, odm/etc, vendor/etc and finally system/etc for that name, falling back to
# system/etc/media_profiles.xml.
# Camcorder: point ro.media.xml_variant.profiles at our own copy of the vendor profile, installed by
# media.mk as media_profiles_froggerpro.xml. It is the vendor file with camera 0's 2160p entry raised
# to 60 fps, which is the combination measured on this device; the vendor file itself declares 60 fps
# for cameras 2/3/4 only. The default "_V1_0" name matches no file here, so MediaProfiles would
# otherwise fall back to the AOSP profiles and lose the vendor's per-camera entries.
#
# The profile declares 60 fps only for cameraId 2/3/4, and only at 2160p. That is not a limit on
# what the back camera (cameraId 0) can record: measured on this device, the logical back camera
# records 3840x2160 at about 60 fps on the ordinary recording path, and the encoder profile resolved
# for it is the cameraId 0 2160p entry, which itself declares frameRate 30. The frame rate a stream
# actually runs at comes from the HAL vendor frame-rate tables, not from the media profile's
# frameRate attribute.
ro.media.xml_variant.profiles=_froggerpro
