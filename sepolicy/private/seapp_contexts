# com.android.bluetooth seapp_contexts. Must live in system_ext, not
# vendor: bluetooth is coredomain and checkseapp rejects a vendor
# seapp_contexts assigning a coredomain. This directory is
# SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS.

# The app is signed with com.android.bt.x509.pem, not the
# bluetooth.x509.pem bound in plat_mac_permissions.xml, so its seinfo
# never resolved to bluetooth and zygote64 aborted. Signatures added
# to sepolicy/{private,vendor}/mac_permissions.xml land in system_ext_/
# vendor_ and do not apply to this partition=system app. The runtime
# seinfo base is therefore default, so use a rule without name=;
# android_seapp.c rejects the whole file if a name= rule has an empty
# or default seinfo. user= matches getpwuid(1002), i.e. bluetooth.
user=bluetooth isPrivApp=true seinfo=default domain=bluetooth type=bluetooth_data_file levelFrom=all
