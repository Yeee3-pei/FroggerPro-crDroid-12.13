# froggerpro_privacy.te -- minimal permissions for FroggerProPrivacy
# (platform_app domain).
#
# Lives in SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS (platform policy); a
# platform_app domain rule cannot be placed in vendor.

# Read of logpersistd_logging_prop lets the app report whether logcatd
# persistence is active. Same pattern as platform_app.te; the property
# is read-only, so this grants read only.
get_prop(platform_app, logpersistd_logging_prop)
