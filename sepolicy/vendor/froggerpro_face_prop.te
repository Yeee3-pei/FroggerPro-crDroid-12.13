# Face HAL property label; resolves the avc denied set on persist.vendor.face.type.
# The type declaration must come first; .te files are processed top to bottom.
# Attribute set matches other CIL vendor_*_prop types:
#   property_type, vendor_property_type, vendor_restricted_property_type.
type vendor_face_config_prop, property_type, vendor_property_type, vendor_restricted_property_type;

# The face service domain is hal_face_default (see file_contexts).
set_prop(hal_face_default, vendor_face_config_prop)
