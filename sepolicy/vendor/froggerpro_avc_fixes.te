# froggerpro_avc_fixes.te - allow rules for AVC denials observed on this device.
# Existing types only, one rule per problem. Some denials are intentionally left unfixed
# because allowing them hits a neverallow.

# vendor_location denied read on vndbinder.
allow vendor_location vndbinder_device:chr_file { read open getattr };

# Nothing charging HAL denied read on /proc/usb_real_type (generic proc type, so a broad read).
allow hal_nt_charger proc:file { read open getattr };

# vendor_location denied creating a netlink route socket.
allow vendor_location self:netlink_route_socket { create bind read write getattr };

# vendor_init denied setting its own vendor.* properties, so those values never applied.
set_prop(vendor_init, vendor_bluetooth_prop)
set_prop(vendor_init, vendor_qms_prop)
set_prop(vendor_init, vendor_ssr_prop)

# vendor_location denied creating the sockets used by loc-mq-thread and lowi-server.
allow vendor_location self:{ netlink_generic_socket netlink_route_socket udp_socket qipcrtr_socket } { create bind read write getattr };

# vendor_location must transition into its lowi-server subdomain. Without the transition the
# child stays in vendor_location and never gets the socket permissions that subdomain has.
domain_auto_trans(vendor_location, vendor_location_lowi_server_exec, vendor_location_lowi_server)

# Nothing face HAL denied create on facedata/sdk; AOSP grants that directory rw_dir_perms only.
allow hal_face_default face_vendor_data_file:dir create;

# Face HAL debug property.
set_prop(hal_face_default, log_tag_prop)

# Not applied: hal_fingerprint_default default_prop and vendor_init bluetooth_prop are both
# rejected by neverallow at build time.
