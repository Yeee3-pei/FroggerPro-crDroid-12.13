hal_client_domain(hal_camera_default, vendor_hal_qspmhal)
allow hal_camera_default vendor_hal_qspmhal_service:service_manager find;

# Traversing the vendor mount point; the QTI provider trips this on every start:
#   avc: denied { search } comm="binder:1608_2" name="vendor" scontext=hal_camera_default
#        tcontext=mnt_vendor_file tclass=dir
allow hal_camera_default mnt_vendor_file:dir r_dir_perms;
