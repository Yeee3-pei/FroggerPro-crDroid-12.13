# CACertService (uid 2918) app domain assignment.
# vendor_mac_permissions.xml has no entry for uid 2918, so its runtime
# seinfo base is platform (privapp) and the blob rule's user=oem_2918
# seinfo=platform matched neither field. uid 2918 < AID_APP_START
# requires a passwd entry, generated from config.fs as vendor_oem_2918.
# android_seapp.c compares seinfo against the base before the first
# colon, so the rule needs seinfo=platform; a rule with name= and an
# empty/default seinfo is rejected by the parser.
user=vendor_oem_2918 isPrivApp=true seinfo=platform name=.cacertservice domain=vendor_cacertservice_app type=app_data_file levelFrom=all
