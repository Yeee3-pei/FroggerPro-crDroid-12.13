# Exec types for stock-ported binaries.
# Attributes follow stock CIL: file_type, exec_type, vendor_file_type.
# Declare only types absent from the prebuilt vendor_sepolicy.cil.
#   A duplicate declaration fails; omitting one leaves the type undefined.

type diagzn_exec, file_type, exec_type, vendor_file_type;
type facsvc_exec, file_type, exec_type, vendor_file_type;
type vendor_hal_camera_default_exec, file_type, exec_type, vendor_file_type;
type vendor_stability_default_exec, file_type, exec_type, vendor_file_type;
