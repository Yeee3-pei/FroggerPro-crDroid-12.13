<compatibility-matrix version="2.0" type="framework">
    <hal format="aidl">
        <name>vendor.goodix.hardware.biometrics.fingerprint</name>
        <interface>
            <name>IGoodixFingerprintDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Sensors -->
    <hal format="aidl" optional="true">
        <name>vendor.noth.hardware.sensor.sensor_extension</name>
        <interface>
            <name>ISensorExtension</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.noth.hardware.charge</name>
        <interface>
            <name>ICharge</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Every HAL the device manifest declares must also appear here, or bacon's
         check_vintf_compatible fails; the thermal entry below was the one missing.
         optional="true" keeps it non-binding in both directions. -->
    <hal format="aidl" optional="true">
        <name>vendor.noth.hardware.thermal</name>
        <interface>
            <name>IThermalControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.qti.memory.pasrmanager</name>
        <interface>
            <name>IPasrManager</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
